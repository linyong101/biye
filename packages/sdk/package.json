{
  "name": "@vigil/web-sdk",
  "version": "0.1.0",
  "description": "Vigil 浏览器端采集 SDK —— 错误 / 性能 / 用户行为",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "monitoring",
    "frontend",
    "error-tracking",
    "web-vitals",
    "apm"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/report-size.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --experimental-test-coverage \"tests/*.test.ts\""
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
